{
  "name": "margin-canvas",
  "version": "0.5.0",
  "description": "A MarginNote-style capture and paste workflow for Obsidian Canvas.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "canvas",
    "zotero",
    "research-workflow"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@codemirror/view": "^6.38.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.8",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
